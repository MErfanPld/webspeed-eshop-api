# Copy to .env and adjust. Never commit real secrets.

# --- Django ---------------------------------------------------------------
# Required. Production needs ≥ 50 random chars:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ------------------------------------------------
POSTGRES_DB=webspeed
POSTGRES_USER=webspeed
POSTGRES_PASSWORD=webspeed
# Docker: host "db" — running locally (runserver): localhost
DATABASE_URL=postgres://webspeed:webspeed@db:5432/webspeed

# --- Cache / rate limiting (Redis) ----------------------------------------
# Docker: redis://redis:6379/0 — running locally (runserver): redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# --- Files (MinIO / S3) ---------------------------------------------------
# "s3" (MinIO/S3) or "local" (filesystem under MEDIA_ROOT; dev only)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
# Public base URL of the media bucket as seen by browsers
S3_PUBLIC_URL=http://localhost:9000/webspeed-media
S3_ACCESS_KEY=webspeed
S3_SECRET_KEY=webspeed-secret
S3_PUBLIC_BUCKET=webspeed-media
S3_PRIVATE_BUCKET=webspeed-private
S3_REGION=us-east-1
# Browser-reachable S3 endpoint for signed receipt URLs (if different from S3_ENDPOINT_URL)
S3_BROWSER_ENDPOINT_URL=http://localhost:9000
# Lifetime of signed receipt URLs (seconds)
PRIVATE_URL_EXPIRE_SECONDS=300

# --- Auth (JWT) -------------------------------------------------------------
# Optional separate signing key (≥ 32 chars). Leave commented to use SECRET_KEY.
# JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Cookies: Secure is forced in production
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
# Set only when the API and frontend share a parent domain, e.g. .example.com
# JWT_COOKIE_DOMAIN=

# --- CORS / CSRF ------------------------------------------------------------
# Exact frontend origins (comma-separated). Required in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Stores & seeding -------------------------------------------------------
# Owner account created by `manage.py seed` (runs on container start).
# Without ADMIN_PASSWORD: DEBUG uses "admin12345", otherwise a random password
# is printed once to the console.
ADMIN_EMAIL=admin@webspeed.local
ADMIN_PASSWORD=
# Store served for hosts that match no custom domain (default: first store)
DEFAULT_STORE_SLUG=

# --- SMS (OTP codes + order status) --------------------------------------------
# "console": printed to the API/worker terminal (free, development)
# "kavenegar": real SMS — set KAVENEGAR_API_KEY (and optionally KAVENEGAR_SENDER)
SMS_BACKEND=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# Return the code in the API response (development/E2E only; forced off in production)
OTP_DEV_RETURN_CODE=True

# --- Proxy ------------------------------------------------------------------
# True only behind a trusted reverse proxy (uses X-Forwarded-For for rate limits)
TRUST_PROXY_HEADERS=False
# SECURE_SSL_REDIRECT=True

# --- Public URLs ------------------------------------------------------------------
# Frontend (password-reset links, payment result redirect)
FRONTEND_URL=http://localhost:3000
# This API as seen by browsers/gateways (payment callback)
API_PUBLIC_URL=http://localhost:8000

# --- Email (admin password reset) -------------------------------------------------
# Development prints emails to the terminal. Production:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=WebSpeed <no-reply@webspeed.local>

# --- Online payment ----------------------------------------------------------------
# "mock": fake gateway page served by this API, every step printed to the terminal
# "zarinpal": real gateway — set ZARINPAL_MERCHANT_ID; ZARINPAL_SANDBOX=False for live
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True

# --- Background jobs (Celery) -------------------------------------------------------
# True runs tasks inline (no worker needed). docker-compose's `worker` sets False.
CELERY_TASK_ALWAYS_EAGER=True
# CELERY_BROKER_URL=  (defaults to REDIS_URL)
